{
  "manifest_version": 3,
  "name": "Vibe Vim",
  "description": "Keyboard-first Vim-style navigation for Chrome, Chromium, and Brave.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Vibe Vim",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
